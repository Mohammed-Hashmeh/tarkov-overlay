{
  "name": "tarkov-overlay",
  "version": "0.3.0",
  "description": "Local interactive Escape from Tarkov map with overlay mode, live position tracking, and quest checklist",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "fetch-data": "node scripts/fetch-data.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"tests/*.test.ts\"",
    "package": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.tarkov-overlay.app",
    "productName": "Tarkov Overlay",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "dir",
        "zip"
      ]
    }
  }
}
